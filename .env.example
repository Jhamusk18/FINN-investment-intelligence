# Copy to .env (repo root or backend/) and fill in. Never commit .env.
# Optional: without it FINN still runs (PUSH fully works; PULL shows cited evidence passages; Guidance vs Actuals is off).
ANTHROPIC_API_KEY=

# Model routing (defaults shown): cheap model for bulk extraction, stronger model only for reasoning.
FINN_FAST_MODEL=claude-haiku-5-5
FINN_STRONG_MODEL=claude-sonnet-5-5

# Set to 1 to force clearly-labelled SIMULATED data in PUSH (offline demos).
FINN_FORCE_SAMPLE=0
